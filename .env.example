# Copy to .env.local. Only Grok needs a key; simulated Claude models work without one.

# xAI API key for real Grok calls (https://console.x.ai). Leave unset to see the
# graceful "Grok unavailable" message instead.
XAI_API_KEY=

# Grok model id sent to xAI. Must have a row in lib/gateway/pricing.ts for cost tracking.
XAI_MODEL=grok-4.7

# OpenAI-compatible xAI endpoint.
XAI_BASE_URL=https://api.x.ai/v1

# Caller identity for the MCP list_traces tool (pnpm mcp). Non-admin roles only see
# traces in MCP_WORKSPACE_ID; admin sees all. With neither set, no traces are returned.
MCP_ROLE=engineer
MCP_WORKSPACE_ID=engineering
