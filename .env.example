# Copy to .env.local. Only Grok needs a key; simulated Claude models work without one.

# xAI API key for real Grok calls (https://console.x.ai). Leave unset to see the
# graceful "Grok unavailable" message instead.
XAI_API_KEY=

# Grok model id sent to xAI. Must have a row in lib/gateway/pricing.ts for cost tracking.
XAI_MODEL=grok-4.7

# OpenAI-compatible xAI endpoint.
XAI_BASE_URL=https://api.x.ai/v1

# Caller identity for the MCP list_traces tool. Non-admin roles only see traces in
# MCP_WORKSPACE_ID; admin sees all. Unset or unknown values return no traces.
# `pnpm mcp` does not load .env files: .cursor/mcp.json sets these for Cursor, and a
# terminal launch needs them exported (e.g. MCP_ROLE=engineer MCP_WORKSPACE_ID=engineering pnpm mcp).
MCP_ROLE=engineer
MCP_WORKSPACE_ID=engineering
